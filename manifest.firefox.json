{
  "manifest_version": 3,
  "name": "BetterGitHub",
  "version": "0.1.0",
  "description": "Personal themes and safe repository, user, and organization appearance on GitHub.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://raw.githubusercontent.com/*"],
  "web_accessible_resources": [{ "resources": ["fonts/*.woff2"], "matches": ["https://github.com/*"] }],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["color-picker.js", "content.js"],
    "css": ["content.css", "color-picker.css"],
    "run_at": "document_start"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "BetterGitHub", "default_icon": "icons/icon-48.png", "default_popup": "popup.html" },
  "browser_specific_settings": { "gecko": {
    "id": "bettergithub@yarilafox",
    "strict_min_version": "140.0",
    "data_collection_permissions": { "required": ["browsingActivity"] }
  }, "gecko_android": { "strict_min_version": "142.0" } }
}
