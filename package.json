{
  "name": "bettergithub",
  "private": true,
  "version": "0.3.6",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:catalog": "powershell -NoProfile -File build.ps1 -Target chromium && node tests/catalog.smoke.mjs",
    "test:catalog:firefox": "powershell -NoProfile -File build.ps1 -Target firefox && node tests/catalog.firefox.smoke.mjs",
    "test:command-hub": "powershell -NoProfile -File build.ps1 -Target chromium && node tests/command-hub.smoke.mjs",
    "test:command-hub:firefox": "powershell -NoProfile -File build.ps1 -Target firefox && node tests/command-hub.firefox.smoke.mjs",
    "test:compact-sidebar": "powershell -NoProfile -File build.ps1 -Target chromium && node tests/compact-sidebar.smoke.mjs",
    "test:compact-sidebar:firefox": "powershell -NoProfile -File build.ps1 -Target firefox && node tests/compact-sidebar.firefox.smoke.mjs",
    "build:firefox": "powershell -NoProfile -File build.ps1 -Target firefox",
    "dev:firefox": "node tools/dev-firefox.mjs",
    "test:firefox": "npm run build:firefox && node tests/firefox-extension.smoke.mjs",
    "lint:extension": "npm run build:firefox && web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "jsdom": "^27.1.0",
    "playwright-core": "^1.65.0",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
