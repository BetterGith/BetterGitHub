{
  "name": "bettergithub",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:firefox": "powershell -NoProfile -File build.ps1 -Target firefox",
    "dev:firefox": "node tools/dev-firefox.mjs",
    "test:firefox": "npm run build:firefox && node tests/firefox-extension.smoke.mjs",
    "lint:extension": "npm run build:firefox && web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "jsdom": "^27.1.0",
    "playwright-core": "^1.65.0",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
